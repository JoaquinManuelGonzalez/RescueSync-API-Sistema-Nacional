    {
      "name": "3. Consultas de catálogo",
      "description": "Consultas protegidas del catálogo nacional. Requieren el rol sistema o administrador.",
      "item": [
        {
          "name": "Catálogo de certificaciones",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/certificaciones?pagina=1&por_pagina=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "certificaciones"
              ],
              "query": [
                {
                  "key": "pagina",
                  "value": "1"
                },
                {
                  "key": "por_pagina",
                  "value": "20"
                }
              ]
            },
            "description": "Lista las certificaciones del catálogo con paginación.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200 con paginación\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  const cuerpo = pm.response.json();",
                  "  pm.expect(cuerpo).to.have.all.keys(\"elementos\", \"pagina\", \"por_pagina\", \"total\");",
                  "  pm.expect(cuerpo.pagina).to.eql(1);",
                  "  pm.expect(cuerpo.por_pagina).to.eql(20);",
                  "  pm.expect(cuerpo.elementos).to.be.an(\"array\");",
                  "  pm.expect(cuerpo.total).to.be.a(\"number\");",
                  "});"
                ]
              }
            }
          ]
        },
