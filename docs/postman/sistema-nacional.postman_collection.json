{
  "info": {
    "name": "RescueSync - API del Sistema Nacional",
    "description": "Pruebas de la autenticación JWT, las consultas de catálogo y el padrón de ONGs. Elegir el entorno (local o render), completar contrasenaAdmin y clientSecretBonita, y correr la colección en orden (Run collection). Ver docs/contratos/autenticacion.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Autenticación",
      "description": "POST /login en sus dos modos y GET /cuentas/yo. Correr primero: los logins guardan los tokens.",
      "item": [
        {
          "name": "Login administrador (JSON)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Login en JSON, el modo para Swagger, Postman y personas.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{usuarioAdmin}}\",\n  \"contrasena\": \"{{contrasenaAdmin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200 con un token Bearer\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  const cuerpo = pm.response.json();",
                  "  pm.expect(cuerpo.token_type).to.eql(\"Bearer\");",
                  "  pm.expect(cuerpo.expires_in).to.be.above(0);",
                  "  pm.collectionVariables.set(\"tokenAdmin\", cuerpo.access_token);",
                  "});",
                  "pm.test(\"El token no se cachea\", () => {",
                  "  pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Bonita (OAuth2 client credentials)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "El mismo pedido que hace el conector REST de Bonita en modo OAUTH2 (Client Credentials).",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{clientIdBonita}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{clientSecretBonita}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200 con un token Bearer\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.collectionVariables.set(\"tokenBonita\", pm.response.json().access_token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con contraseña incorrecta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Mismo mensaje para usuario inexistente o contraseña incorrecta.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{usuarioAdmin}}\",\n  \"contrasena\": \"incorrecta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401 NO_AUTENTICADO\", () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error.codigo).to.eql(\"NO_AUTENTICADO\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login OAuth2 con secreto incorrecto",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "En modo OAuth2 los errores siguen el RFC 6749, como los espera el conector de Bonita.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{clientIdBonita}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "incorrecto",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401 invalid_client (RFC 6749)\", () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error).to.eql(\"invalid_client\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cuenta del token (administrador)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cuentas/yo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cuentas",
                "yo"
              ]
            },
            "description": "Muestra la cuenta, el rol y el vencimiento del token.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Rol administrador\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().rol).to.eql(\"administrador\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cuenta del token (Bonita, con trazabilidad)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Usuario-Bonita",
                "value": "operador@chascomus.test"
              },
              {
                "key": "X-Bonita-Process-Instance-Id",
                "value": "4021"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cuentas/yo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cuentas",
                "yo"
              ]
            },
            "description": "Bonita informa la persona y el caso del proceso. La API solo las acepta del rol sistema.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenBonita}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Rol sistema con trazabilidad\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  const cuerpo = pm.response.json();",
                  "  pm.expect(cuerpo.rol).to.eql(\"sistema\");",
                  "  pm.expect(cuerpo.trazabilidad.usuario_bonita).to.eql(\"operador@chascomus.test\");",
                  "  pm.expect(cuerpo.trazabilidad.caso_bonita).to.eql(\"4021\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Protección de los endpoints",
      "description": "Pedidos rechazados: sin token, con token adulterado y con un rol sin permiso.",
      "item": [
        {
          "name": "Sin token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ongs/30-99999999-4",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ongs",
                "30-99999999-4"
              ]
            },
            "description": "Sin encabezado Authorization: 401 token_ausente.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401 NO_AUTENTICADO\", () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error.codigo).to.eql(\"NO_AUTENTICADO\");",
                  "});",
                  "pm.test(\"Motivo: token_ausente\", () => {",
                  "  pm.expect(pm.response.json().error.detalle.motivo).to.eql(\"token_ausente\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Token adulterado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ongs/30-99999999-4",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ongs",
                "30-99999999-4"
              ]
            },
            "description": "Se invierte la firma del token del administrador: la API detecta la alteración.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdulterado}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const partes = pm.collectionVariables.get(\"tokenAdmin\").split(\".\");",
                  "partes[2] = partes[2].split(\"\").reverse().join(\"\");",
                  "pm.collectionVariables.set(\"tokenAdulterado\", partes.join(\".\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401 NO_AUTENTICADO\", () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error.codigo).to.eql(\"NO_AUTENTICADO\");",
                  "});",
                  "pm.test(\"Motivo: token_invalido\", () => {",
                  "  pm.expect(pm.response.json().error.detalle.motivo).to.eql(\"token_invalido\");",
                  "});"
                ]
              }
            }
          ]
        },
