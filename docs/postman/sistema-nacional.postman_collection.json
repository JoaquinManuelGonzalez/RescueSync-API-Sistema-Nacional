    {
      "name": "4. Padrón de ONGs",
      "description": "Onboarding y estado de habilitación. Deja Cruz Roja Bahía Blanca suspendida, como estaba.",
      "item": [
        {
          "name": "Consultar ONG suspendida (Bonita)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ongs/30-99999999-4",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ongs",
                "30-99999999-4"
              ]
            },
            "description": "Cruz Roja Bahía Blanca está registrada pero suspendida: no puede ofertar.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenBonita}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Está suspendida y no puede ofertar\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  const cuerpo = pm.response.json();",
                  "  pm.expect(cuerpo.estado_habilitacion).to.eql(\"suspendida\");",
                  "  pm.expect(cuerpo.habilitada).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Alta de ONG (onboarding)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ongs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ongs"
              ]
            },
            "description": "Registra una ONG nueva en estado pendiente. El CUIT se genera al azar en cada corrida.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cuit\": \"{{cuitNueva}}\",\n  \"nombre\": \"ONG de prueba {{cuitNueva}}\",\n  \"mail_contacto\": \"prueba+{{cuitNueva}}@ong.example\",\n  \"telefono_contacto\": \"+54 221 555-0000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let cuit = '30';",
                  "for (let i = 0; i < 9; i++) { cuit += Math.floor(Math.random() * 10); }",
                  "pm.collectionVariables.set(\"cuitNueva\", cuit);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201 pendiente\", () => {",
                  "  pm.response.to.have.status(201);",
                  "  const cuerpo = pm.response.json();",
                  "  pm.expect(cuerpo.estado_habilitacion).to.eql(\"pendiente\");",
                  "  pm.expect(cuerpo.habilitada).to.eql(false);",
                  "  pm.collectionVariables.set(\"cuitNueva\", cuerpo.cuit);",
                  "});"
                ]
              }
            }
          ]
        },
