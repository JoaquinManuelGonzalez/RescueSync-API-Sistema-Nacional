                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200 con organizaciones paginadas\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  const cuerpo = pm.response.json();",
                  "  pm.expect(cuerpo).to.have.all.keys(\"elementos\", \"pagina\", \"por_pagina\", \"total\");",
                  "  pm.expect(cuerpo.elementos).to.be.an(\"array\");",
                  "  pm.expect(cuerpo.total).to.be.a(\"number\");",
