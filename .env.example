# =============================================================================
# API del Sistema Nacional (RescueSync) - plantilla de variables de entorno
# =============================================================================
# Copiar a .env (cp .env.example .env) y completar. .env NUNCA se commitea.
# Las variables marcadas con (*) son obligatorias: sin ellas la API no arranca.
# Detalle de cada variable: docs/contratos/configuracion.md
#
# Este archivo es solo para el entorno LOCAL (docker compose). En Render las variables
# salen de render.yaml y del dashboard.

# =============================================================================
# Aplicacion
# =============================================================================

# Entorno de ejecucion: local | evaluacion | produccion
APP_ENV=local

# (*) Clave secreta de Flask. Para generar una:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Puerto de la API dentro del contenedor y en el host (http://localhost:8000).
PORT=8000

# Nivel minimo de log: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=DEBUG

# Workers de gunicorn (solo aplica al target de produccion). En Render lo fija la plataforma.
# WEB_CONCURRENCY=2

# =============================================================================
# Base de datos (PostgreSQL del docker-compose)
# =============================================================================

# (*) Credenciales con las que se crea el PostgreSQL local. Elegir cualquiera.
POSTGRES_USER=sistema_nacional
POSTGRES_PASSWORD=
POSTGRES_DB=sistema_nacional

# Puerto del host donde se publica PostgreSQL. 5433 para no chocar con la base de la web app.
POSTGRES_HOST_PORT=5433

# (*) Cadena de conexion que usa la API. El host "db" es el nombre del servicio en
# docker-compose.yml. Tiene que repetir el usuario, la contrasena y la base de arriba.
DATABASE_URL=postgresql+psycopg://sistema_nacional:CAMBIAR@db:5432/sistema_nacional

# TLS hacia la base. Vacio en local; en la nube (Supabase) se usa "require".
DATABASE_SSLMODE=
